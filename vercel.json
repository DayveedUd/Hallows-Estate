{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/resident-login.html",
      "destination": "/public/resident-login.html"
    },
    {
      "source": "/resident-portal.html",
      "destination": "/public/resident-portal.html"
    },
    {
      "source": "/admin-portal.html",
      "destination": "/public/admin-portal.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}